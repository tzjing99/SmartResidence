{
  "name": "@smartresidence/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "SmartResidence backend API (NestJS).",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "prebuild": "corepack pnpm --filter @smartresidence/shared-types build",
    "predev": "corepack pnpm --filter @smartresidence/shared-types build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && corepack pnpm exec prisma generate",
    "db:migrate:deploy": "prisma migrate deploy && corepack pnpm exec prisma generate",
    "db:reset": "prisma migrate reset --force && corepack pnpm db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.7.2",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-socket.io": "^10.4.7",
    "@nestjs/swagger": "^8.0.5",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.7",
    "@prisma/client": "^5.22.0",
    "@smartresidence/shared-types": "workspace:*",
    "argon2": "^0.41.1",
    "better-auth": "^1.0.6",
    "bullmq": "^5.25.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-holidays": "^3.30.2",
    "expo-server-sdk": "^3.13.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "minio": "^8.0.2",
    "multer": "^2.1.1",
    "nanoid": "^5.0.8",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "stripe": "^17.4.0",
    "twilio": "^5.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@smartresidence/config-tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
