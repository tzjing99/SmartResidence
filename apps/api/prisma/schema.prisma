// SmartResidence — Prisma schema
// See docs/architecture/data-model.md for an overview.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////////////////////////////
// Identity & sessions
//////////////////////////////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String?    @unique
  name            String
  avatarUrl       String?
  locale          String     @default("en")
  passwordHash    String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  totpSecret      String?
  status          UserStatus @default(ACTIVE)
  // Per-user notification prefs: email opt-in (E1), quiet hours (E5).
  preferences     Json       @default("{}")
  lastSeenAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  ownerships         Ownership[]
  tenancies          Tenancy[]            @relation("tenantUser")
  householdMembers   HouseholdMember[]    @relation("memberUser")
  addedHouseholdRefs HouseholdMember[]    @relation("addedByUser")
  roleAssignments    RoleAssignment[]     @relation("assigneeUser")
  grantedRoles       RoleAssignment[]     @relation("granterUser")
  sessions           Session[]
  passkeys           PasskeyCredential[]
  hostedVisitors     Visitor[]            @relation("hostUser")
  recurringPasses    RecurringPass[]      @relation("recurringPassHost")
  blacklistEntries   VisitorBlacklist[]   @relation("blacklistCreatedBy")
  visitorPolicies    UnitVisitorPolicy[]
  approvedVisitors   Visitor[]            @relation("approverUser")
  admittedWalkIns    Visitor[]            @relation("admittedByGuard")
  guardCheckIns      VisitorCheckIn[]     @relation("checkInGuard")
  guardCheckOuts     VisitorCheckIn[]     @relation("checkOutGuard")
  payments           Payment[]
  advancePayments    AdvancePayment[]
  raisedDefects      Defect[]             @relation("raisedBy")
  assignedDefects    Defect[]             @relation("assignedTo")
  raisedDefectReports DefectReport[]      @relation("reportRaisedBy")
  defectUpdates      DefectUpdate[]
  attachmentUploads  Attachment[]
  authoredAnnouncements Announcement[]    @relation("announcementAuthor")
  acknowledgments    AnnouncementAck[]
  announcementReads  AnnouncementRead[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  auditEvents        AuditLog[]           @relation("auditActor")
  verificationCodes  VerificationCode[]
  threadsCreated       Thread[]            @relation("threadCreatedBy")
  threadsAssigned      Thread[]            @relation("threadAssignedTo")
  threadMessages       ThreadMessage[]     @relation("threadMessageAuthor")
  threadParticipations ThreadParticipant[] @relation("threadParticipant")
  faqArticles          FaqArticle[]        @relation("faqAuthor")
  favouriteVisitors    FavouriteVisitor[]
  deposits             Deposit[]
  receipts             Receipt[]
  pollsCreated         Poll[]     @relation("pollAuthor")
  pollVotes            PollVote[]
  generalMeetingsCreated GeneralMeeting[] @relation("meetingAuthor")
  meetingProxiesSubmitted MeetingProxy[] @relation("proxyOwner")
  meetingProxiesHeld      MeetingProxy[] @relation("proxyHolder")
  bookings             Booking[]
  sosRaised            SosAlert[] @relation("sosRaisedBy")
  sosAcknowledged      SosAlert[] @relation("sosAcknowledgedBy")
  sosResolved          SosAlert[] @relation("sosResolvedBy")
  patrolScans          PatrolScan[] @relation("patrolScanGuard")
  parcelsReceived      Parcel[]     @relation("parcelReceivedByGuard")
  parcelsCollected     Parcel[]     @relation("parcelCollectedBy")
  formSubmissions      FormSubmission[] @relation("formSubmitter")
  formReviews          FormSubmission[] @relation("formReviewer")
  documentVersionsUploaded DocumentVersion[] @relation("documentVersionUploader")
  lostFoundPosts         LostFoundPost[]     @relation("lostFoundAuthor")
  glJournalEntriesPosted GlJournalEntry[]    @relation("glJournalPoster")
  bankStatementImports   BankStatementImport[] @relation("bankStatementImporter")
  vendorBillsApproved    VendorBill[]        @relation("vendorBillApprover")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  refreshTokenHash String?  @unique
  ipAddress       String?
  userAgent       String?
  deviceInfo      Json?
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasskeyCredential {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String   @unique
  publicKey     Bytes
  counter       BigInt   @default(0)
  deviceType    String?
  transports    String[]
  nickname      String?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?

  @@index([userId])
  @@map("passkey_credentials")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  LOGIN_OTP
}

model VerificationCode {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @db.Uuid
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier  String
  codeHash    String
  purpose     VerificationPurpose
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now())

  @@index([identifier, purpose])
  @@map("verification_codes")
}

//////////////////////////////////////////////////////////////////////////////
// Tenancy: Condo / Block / Unit / Ownership / Tenancy / HouseholdMember
//////////////////////////////////////////////////////////////////////////////

model Condo {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  address         String
  countryCode     String   @default("MY")
  currencyCode    String   @default("MYR")
  timezone        String   @default("Asia/Kuala_Lumpur")
  locale          String   @default("en")
  feeFormulaConfig Json    @default("{}")
  brandColor      String?
  logoUrl         String?
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  blocks          Block[]
  units           Unit[]
  visitors        Visitor[]
  visitorBlacklist VisitorBlacklist[]
  recurringPasses RecurringPass[]
  unitVisitorPolicies UnitVisitorPolicy[]
  invoices        Invoice[]
  defects         Defect[]
  announcements   Announcement[]
  roleAssignments RoleAssignment[]
  auditLogs       AuditLog[]
  threads         Thread[]
  slaPolicies     SlaPolicy[]
  faqCategories   FaqCategory[]
  faqArticles     FaqArticle[]
  unitTypes        UnitType[]
  defectSpaceTypes DefectSpaceType[]
  defectElements   DefectElement[]
  defectIssues     DefectIssue[]
  defectReports    DefectReport[]
  unitTypeFeeRates UnitTypeFeeRate[]
  feeScheduleExtraLines FeeScheduleExtraLine[]
  deposits         Deposit[]
  receipts         Receipt[]
  ledgerEntries    LedgerEntry[]
  unitAccounts     UnitAccount[]
  gatewayConnections PaymentGatewayConnection[]
  billingNumberSequences BillingNumberSequence[]
  advancePayments  AdvancePayment[]
  automationRuns   AutomationRun[]
  polls            Poll[]
  generalMeetings  GeneralMeeting[]
  mcpServerConnections McpServerConnection[]
  facilities       Facility[]
  bookings         Booking[]
  eInvoices        EInvoice[]
  sosAlerts        SosAlert[]
  patrolCheckpoints PatrolCheckpoint[]
  patrolScans      PatrolScan[]
  parcels          Parcel[]
  formTemplates    FormTemplate[]
  formSubmissions  FormSubmission[]
  documentFolders  DocumentFolder[]
  documents        Document[]
  lostFoundPosts   LostFoundPost[]
  glAccounts       GlAccount[]
  glJournalEntries GlJournalEntry[]
  bankStatementImports BankStatementImport[]
  vendors          Vendor[]
  vendorBills      VendorBill[]

  @@map("condos")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  condoId   String   @db.Uuid
  condo     Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units Unit[]
  announcementBlocks AnnouncementBlock[]

  @@unique([condoId, name])
  @@index([condoId])
  @@map("blocks")
}

enum UnitStatus {
  OCCUPIED
  VACANT
  UNDER_RENO
  RESERVED
}

model Unit {
  id          String     @id @default(uuid()) @db.Uuid
  condoId     String     @db.Uuid
  condo       Condo      @relation(fields: [condoId], references: [id], onDelete: Cascade)
  blockId     String     @db.Uuid
  block       Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  identifier  String
  floor       Int?
  sqft        Decimal?   @db.Decimal(10, 2)
  bedrooms    Int?
  bathrooms   Int?
  unitTypeId  String?    @db.Uuid
  unitType    UnitType?  @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  status      UnitStatus @default(OCCUPIED)
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  ownerships       Ownership[]
  tenancies        Tenancy[]
  householdMembers HouseholdMember[]
  visitors         Visitor[]
  favouriteVisitors FavouriteVisitor[]
  recurringPasses  RecurringPass[]
  visitorPolicies  UnitVisitorPolicy[]
  invoices         Invoice[]
  defects          Defect[]
  defectReports    DefectReport[]
  roleAssignments  RoleAssignment[]
  auditLogs        AuditLog[]
  threads          Thread[]
  announcementUnits AnnouncementUnit[]
  deposits         Deposit[]
  receipts         Receipt[]
  ledgerEntries    LedgerEntry[]
  unitAccount      UnitAccount?
  advancePayments  AdvancePayment[]
  pollVotes        PollVote[]
  meetingProxies   MeetingProxy[]
  bookings         Booking[]
  sosAlerts        SosAlert[]
  parcels          Parcel[]
  formSubmissions  FormSubmission[]
  lostFoundPosts   LostFoundPost[]

  @@unique([condoId, identifier])
  @@index([blockId])
  @@index([unitTypeId])
  @@map("units")
}

enum OwnershipStatus {
  ACTIVE
  PENDING
  ENDED
}

model Ownership {
  id           String          @id @default(uuid()) @db.Uuid
  unitId       String          @db.Uuid
  unit         Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharePercent Decimal         @default(100) @db.Decimal(6, 3)
  isPrimary    Boolean         @default(true)
  startDate    DateTime        @default(now())
  endDate      DateTime?
  status       OwnershipStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenancies Tenancy[]
  pollVotes PollVote[]

  @@unique([unitId, userId, startDate])
  @@index([unitId])
  @@index([userId])
  @@map("ownerships")
}

enum TenancyStatus {
  ACTIVE
  PENDING
  TERMINATED
  EXPIRED
}

model Tenancy {
  id                 String        @id @default(uuid()) @db.Uuid
  unitId             String        @db.Uuid
  unit               Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId             String        @db.Uuid
  user               User          @relation("tenantUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByOwnershipId String?     @db.Uuid
  createdByOwnership Ownership?    @relation(fields: [createdByOwnershipId], references: [id])
  startDate          DateTime
  endDate            DateTime?
  status             TenancyStatus @default(ACTIVE)
  accessRestrictions Json          @default("{}")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([unitId])
  @@index([userId])
  @@map("tenancies")
}

model HouseholdMember {
  id           String   @id @default(uuid()) @db.Uuid
  unitId       String   @db.Uuid
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId       String   @db.Uuid
  user         User     @relation("memberUser", fields: [userId], references: [id], onDelete: Cascade)
  relationship String?
  addedByUserId String? @db.Uuid
  addedBy      User?    @relation("addedByUser", fields: [addedByUserId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([unitId, userId])
  @@map("household_members")
}

//////////////////////////////////////////////////////////////////////////////
// RBAC
//////////////////////////////////////////////////////////////////////////////

enum RoleId {
  SUPER_ADMIN
  MANAGEMENT_ADMIN
  MANAGEMENT_STAFF
  SECURITY_GUARD
  UNIT_OWNER
  TENANT
  HOUSEHOLD_MEMBER
  CONTRACTOR
}

enum RoleScope {
  PLATFORM
  CONDO
  UNIT
}

model Role {
  id          RoleId    @id
  name        String
  description String?
  scope       RoleScope

  assignments RoleAssignment[]

  @@map("roles")
}

model RoleAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  roleId        RoleId
  role          Role      @relation(fields: [roleId], references: [id])
  userId        String    @db.Uuid
  user          User      @relation("assigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  condoId       String?   @db.Uuid
  condo         Condo?    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId        String?   @db.Uuid
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  permissions   Json      @default("[]")
  grantedByUserId String? @db.Uuid
  grantedBy     User?     @relation("granterUser", fields: [grantedByUserId], references: [id])
  grantedAt     DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?

  @@index([userId])
  @@index([condoId])
  @@index([unitId])
  @@index([roleId])
  @@map("role_assignments")
}

//////////////////////////////////////////////////////////////////////////////
// Visitor management
//////////////////////////////////////////////////////////////////////////////

enum VisitorVisitType {
  PRE_REG
  WALKIN_UNIT
  WALKIN_OFFICE
}

enum VisitorEntryMode {
  WALK_IN
  DRIVE_IN
}

enum VisitorPurpose {
  VISITOR
  CONTRACTOR
  GOVERNMENT_UTILITIES
  DELIVERY
  MAINTENANCE
  OTHER
}

enum VisitorStatus {
  PENDING_OWNER_APPROVAL
  PENDING_MANAGEMENT_APPROVAL
  APPROVED
  REJECTED
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
  CANCELLED
}

enum VisitorPassKind {
  STANDARD
  DELIVERY
  E_HAILING
}

enum DeliveryPlatform {
  GRABFOOD
  FOODPANDA
  SHOPEE_FOOD
  GRAB
  OTHER
}

model Visitor {
  id            String           @id @default(uuid()) @db.Uuid
  condoId       String           @db.Uuid
  condo         Condo            @relation(fields: [condoId], references: [id], onDelete: Cascade)
  visitType     VisitorVisitType @default(PRE_REG)
  passKind      VisitorPassKind  @default(STANDARD)
  deliveryPlatform DeliveryPlatform?
  unitId        String?          @db.Uuid
  unit          Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hostUserId    String?          @db.Uuid
  host          User?            @relation("hostUser", fields: [hostUserId], references: [id], onDelete: Cascade)
  name          String
  identification String?
  phone         String?
  phoneCountryCode String       @default("+60")
  entryMode     VisitorEntryMode @default(WALK_IN)
  vehiclePlate  String?
  vehiclePlatePhotoUrl String?
  plateMismatchFlagged Boolean     @default(false)
  purpose       VisitorPurpose @default(VISITOR)
  overnight     Boolean          @default(false)
  urgentOvernight Boolean        @default(false)
  urgentReason  String?
  pendingManagementReview Boolean @default(false)
  expectedAt    DateTime
  expectedDurationMins Int?
  qrCode        String?          @unique
  qrPayload     String?          @unique
  accessCode    String?
  expiresAt     DateTime?
  approvalDeadline DateTime?
  status        VisitorStatus    @default(APPROVED)
  approvedByUserId String?       @db.Uuid
  approvedBy    User?            @relation("approverUser", fields: [approvedByUserId], references: [id])
  approvedAt    DateTime?
  // Guard who admitted a walk-in on the spot at the gate (on-site discretion).
  // Distinct from approvedBy (owner/management approval) for accountability.
  admittedByGuardUserId String?  @db.Uuid
  admittedByGuard User?          @relation("admittedByGuard", fields: [admittedByGuardUserId], references: [id])
  cancelledAt   DateTime?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  checkIns VisitorCheckIn[]

  @@unique([condoId, accessCode])
  @@index([condoId])
  @@index([unitId])
  @@index([hostUserId])
  @@index([status])
  @@index([expectedAt])
  @@index([expiresAt])
  @@index([approvalDeadline])
  // Condo-scoped, date-bounded lists & stats (guard boards, admin dashboards).
  @@index([condoId, expectedAt])
  @@index([condoId, overnight, status])
  @@map("visitors")
}

model VisitorCheckIn {
  id              String    @id @default(uuid()) @db.Uuid
  visitorId       String    @db.Uuid
  visitor         Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  checkInAt       DateTime  @default(now())
  checkInGuardId  String?   @db.Uuid
  checkInGuard    User?     @relation("checkInGuard", fields: [checkInGuardId], references: [id])
  checkOutAt      DateTime?
  checkOutGuardId String?   @db.Uuid
  checkOutGuard   User?     @relation("checkOutGuard", fields: [checkOutGuardId], references: [id])
  gateLocation    String?
  notes           String?

  @@index([visitorId])
  @@index([checkInAt])
  @@map("visitor_check_ins")
}

model FavouriteVisitor {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId       String   @db.Uuid
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  phoneCountryCode String @default("+60")
  entryMode    VisitorEntryMode @default(WALK_IN)
  vehiclePlate String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([unitId])
  @@index([userId])
  @@map("favourite_visitors")
}

model UnitVisitorPolicy {
  id                      String    @id @default(uuid()) @db.Uuid
  condoId                 String    @db.Uuid
  condo                   Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId                  String    @db.Uuid
  unit                    Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  overnightSuspendedUntil DateTime?
  suspendReason           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([unitId, userId])
  @@index([condoId])
  @@map("unit_visitor_policies")
}

model VisitorBlacklist {
  id              String    @id @default(uuid()) @db.Uuid
  condoId         String    @db.Uuid
  condo           Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name            String?
  phone           String?
  vehiclePlate    String?
  idNumber        String?
  reason          String
  createdByUserId String    @db.Uuid
  createdBy       User      @relation("blacklistCreatedBy", fields: [createdByUserId], references: [id])
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([condoId])
  @@index([condoId, vehiclePlate])
  @@index([condoId, phone])
  @@map("visitor_blacklist")
}

model RecurringPass {
  id           String   @id @default(uuid()) @db.Uuid
  condoId      String   @db.Uuid
  condo        Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId       String   @db.Uuid
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hostUserId   String   @db.Uuid
  host         User     @relation("recurringPassHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  guestName    String
  guestPhone   String?
  vehiclePlate String?
  schedule     Json
  validFrom    DateTime
  validUntil   DateTime
  accessCode   String?
  qrPayload    String?  @unique
  qrCode       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([condoId, accessCode])
  @@index([condoId])
  @@index([unitId])
  @@index([hostUserId])
  @@index([condoId, vehiclePlate])
  @@index([condoId, guestPhone])
  @@map("recurring_passes")
}

//////////////////////////////////////////////////////////////////////////////
// Billing
//////////////////////////////////////////////////////////////////////////////

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
  OVERDUE
}

/// Lifecycle of a Malaysian LHDN MyInvois e-invoice for an Invoice.
enum EInvoiceStatus {
  NOT_SUBMITTED
  PENDING
  VALID
  INVALID
  CANCELLED
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  condoId      String        @db.Uuid
  condo        Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId       String        @db.Uuid
  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  number       String
  periodStart  DateTime
  periodEnd    DateTime
  dueDate      DateTime
  status       InvoiceStatus @default(DRAFT)
  subtotal     Decimal       @default(0) @db.Decimal(14, 2)
  tax          Decimal       @default(0) @db.Decimal(14, 2)
  discount     Decimal       @default(0) @db.Decimal(14, 2)
  total        Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid   Decimal       @default(0) @db.Decimal(14, 2)
  currencyCode String        @default("MYR")
  issuedAt     DateTime?
  paidAt       DateTime?
  voidedAt     DateTime?
  metadata     Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]
  eInvoice EInvoice?

  @@unique([condoId, number])
  @@index([condoId, status])
  @@index([condoId, status, dueDate])
  @@index([unitId])
  @@index([unitId, periodStart, status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  code        String
  description String
  formula     String?
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(14, 4)
  amount      Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  FPX
  IPAY88
  RAZER
  DUITNOW_QR
  TNG
  MANUAL
}

enum FeeRateType {
  PER_SQFT
  FLAT
}

enum FeeScheduleLineRateType {
  FLAT
  PER_SQFT
  PER_UNIT_TYPE
}

enum DepositType {
  RENOVATION
  RENOVATION_DELIVERY
  ACCESS_CARD
  KEY
  MOVE_IN_OUT
  OTHER
}

enum DepositStatus {
  HELD
  PARTIALLY_REFUNDED
  REFUNDED
  FORFEITED
}

enum ReceiptKind {
  PAYMENT
  DEPOSIT
  REFUND
}

enum LedgerFund {
  MAINTENANCE
  SINKING_FUND
  DEPOSIT
  GENERAL
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
  DEPOSIT
  REFUND
  PREPAYMENT
  PREPAYMENT_APPLIED
  ADJUSTMENT
}

enum GatewayMode {
  TEST
  LIVE
}

enum AutomationJobKey {
  BILLING_GENERATION
  DUE_SWEEP
  PAYMENT_RECONCILIATION
  PAYMENT_REVIEW
  REMINDERS
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum McpTransport {
  STREAMABLE_HTTP
  HTTP_SSE
  STDIO
}

enum McpConnectionTestStatus {
  UNTESTED
  OK
  FAILED
}

model Payment {
  id           String          @id @default(uuid()) @db.Uuid
  invoiceId    String          @db.Uuid
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId       String?         @db.Uuid
  user         User?           @relation(fields: [userId], references: [id])
  amount       Decimal         @db.Decimal(14, 2)
  currencyCode String          @default("MYR")
  status       PaymentStatus   @default(PENDING)
  provider     PaymentProvider
  providerRef  String?
  paidAt       DateTime?
  receiptUrl   String?
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  receipt Receipt?

  @@index([invoiceId])
  @@index([providerRef])
  @@index([status])
  @@map("payments")
}

/// Resident-initiated advance maintenance payments. These are gateway-backed
/// prepayments that become unit credit only after a verified successful callback.
model AdvancePayment {
  id           String          @id @default(uuid()) @db.Uuid
  condoId      String          @db.Uuid
  condo        Condo           @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId       String          @db.Uuid
  unit         Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId       String?         @db.Uuid
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount       Decimal         @db.Decimal(14, 2)
  currencyCode String          @default("MYR")
  status       PaymentStatus   @default(PENDING)
  provider     PaymentProvider
  providerRef  String?
  paidAt       DateTime?
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([condoId, status])
  @@index([unitId])
  @@index([userId])
  @@index([providerRef])
  @@map("advance_payments")
}

/// Per-unit-type monthly fee config. Drives automatic invoice generation:
/// maintenance + sinking-fund lines computed from the unit's type & sqft.
model UnitTypeFeeRate {
  id                  String      @id @default(uuid()) @db.Uuid
  condoId             String      @db.Uuid
  condo               Condo       @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitTypeId          String      @unique @db.Uuid
  unitType            UnitType    @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)
  maintenanceRateType FeeRateType @default(PER_SQFT)
  maintenanceAmount   Decimal     @default(0) @db.Decimal(14, 4)
  sinkingFundRateType FeeRateType @default(PER_SQFT)
  sinkingFundAmount   Decimal     @default(0) @db.Decimal(14, 4)
  currencyCode        String      @default("MYR")
  effectiveFrom       DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([condoId])
  @@map("unit_type_fee_rates")
}

/// Additional monthly fee schedule lines beyond maintenance and sinking fund
/// (e.g. fire insurance, quit rent, assessment, special levy). These are
/// automatically included in scheduled billing cycles when active for a period.
model FeeScheduleExtraLine {
  id              String                  @id @default(uuid()) @db.Uuid
  condoId         String                  @db.Uuid
  condo           Condo                   @relation(fields: [condoId], references: [id], onDelete: Cascade)
  code            String
  description     String
  category        String                  @default("OTHER")
  /// Ledger fund for invoice generation — required for Strata Act fund separation.
  fund            LedgerFund
  formula         String?
  rateType        FeeScheduleLineRateType @default(FLAT)
  amount          Decimal                 @default(0) @db.Decimal(14, 4)
  unitTypeAmounts Json                    @default("{}")
  recurring       Boolean                 @default(false)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  enabled         Boolean                 @default(true)
  sortOrder       Int                     @default(100)
  metadata        Json                    @default("{}")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([condoId, enabled])
  @@index([condoId, code])
  @@index([condoId, effectiveFrom, effectiveTo])
  @@map("fee_schedule_extra_lines")
}

/// A refundable deposit held against a unit (renovation, delivery, access card,
/// etc.). Recording one auto-issues an official Receipt.
model Deposit {
  id                String        @id @default(uuid()) @db.Uuid
  condoId           String        @db.Uuid
  condo             Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId            String        @db.Uuid
  unit              Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId            String?       @db.Uuid
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  type              DepositType
  amount            Decimal       @db.Decimal(14, 2)
  currencyCode      String        @default("MYR")
  status            DepositStatus @default(HELD)
  method            String?
  reference         String?
  refundedAmount    Decimal       @default(0) @db.Decimal(14, 2)
  forfeitedAmount   Decimal       @default(0) @db.Decimal(14, 2)
  paidAt            DateTime      @default(now())
  refundedAt        DateTime?
  notes             String?
  recordedByUserId  String?       @db.Uuid
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  receipt Receipt?

  @@index([condoId, status])
  @@index([unitId])
  @@index([userId])
  @@map("deposits")
}

/// An official receipt, auto-generated on payment success or deposit recording.
/// templateSnapshot freezes the condo's receipt template at issue time so a
/// reprinted receipt always matches what was originally issued.
model Receipt {
  id               String      @id @default(uuid()) @db.Uuid
  condoId          String      @db.Uuid
  condo            Condo       @relation(fields: [condoId], references: [id], onDelete: Cascade)
  number           String
  kind             ReceiptKind
  amount           Decimal     @db.Decimal(14, 2)
  currencyCode     String      @default("MYR")
  issuedToUserId   String?     @db.Uuid
  issuedTo         User?       @relation(fields: [issuedToUserId], references: [id], onDelete: SetNull)
  unitId           String?     @db.Uuid
  unit             Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  paymentId        String?     @unique @db.Uuid
  payment          Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  depositId        String?     @unique @db.Uuid
  deposit          Deposit?    @relation(fields: [depositId], references: [id], onDelete: SetNull)
  description      String?
  templateSnapshot Json        @default("{}")
  pdfKey           String?
  issuedAt         DateTime    @default(now())
  voidedAt         DateTime?
  createdAt        DateTime    @default(now())

  @@unique([condoId, number])
  @@index([condoId, kind])
  @@index([unitId])
  @@index([issuedToUserId])
  @@map("receipts")
}

/// Append-only accounting ledger. Charges, payments, deposits and prepayments
/// are recorded here, fund-tagged (maintenance vs sinking fund), to drive
/// fund-balance and collections reporting. `amount` is signed: positive for
/// money collected into / owed to a fund.
model LedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  condoId          String          @db.Uuid
  condo            Condo           @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId           String?         @db.Uuid
  unit             Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  fund             LedgerFund      @default(GENERAL)
  type             LedgerEntryType
  amount           Decimal         @db.Decimal(14, 2)
  idempotencyKey   String?
  sourceType       String
  sourceId         String?
  memo             String?
  createdByUserId  String?         @db.Uuid
  occurredAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([condoId, fund, occurredAt])
  @@index([condoId, type, occurredAt])
  @@index([unitId, occurredAt])
  @@unique([idempotencyKey])
  @@map("ledger_entries")
}

/// Atomic per-condo/year counters for externally visible billing numbers.
/// Keeps invoice and receipt numbers race-safe under concurrent operations.
model BillingNumberSequence {
  id         String   @id @default(uuid()) @db.Uuid
  condoId    String   @db.Uuid
  condo      Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  kind       String
  year       Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([condoId, kind, year])
  @@index([condoId])
  @@map("billing_number_sequences")
}

/// Per-unit cached account balance — currently the prepayment (advance
/// maintenance) credit available to offset future invoices.
model UnitAccount {
  id            String   @id @default(uuid()) @db.Uuid
  condoId       String   @db.Uuid
  condo         Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId        String   @unique @db.Uuid
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  creditBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([condoId])
  @@map("unit_accounts")
}

/// Per-condo payment gateway connection. Secret credentials are stored as an
/// AES-256-GCM envelope (ciphertext + iv + auth tag) and never returned to the
/// client; only non-secret `publicConfig` (e.g. merchant code) is exposed.
model PaymentGatewayConnection {
  id              String          @id @default(uuid()) @db.Uuid
  condoId         String          @db.Uuid
  condo           Condo           @relation(fields: [condoId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  mode            GatewayMode     @default(TEST)
  enabled         Boolean         @default(false)
  displayName     String?
  publicConfig    Json            @default("{}")
  encryptedSecret Bytes?
  secretIv        Bytes?
  secretAuthTag   Bytes?
  keyVersion      Int             @default(1)
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([condoId, provider, mode])
  @@index([condoId])
  @@map("payment_gateway_connections")
}

/// Malaysian LHDN MyInvois e-invoice tracking for an Invoice (1:1). Stores the
/// generated UBL/JSON payload snapshot plus the identifiers + validation state
/// returned by LHDN (or the sandbox adapter). The verification QR / URL is
/// surfaced on the receipt/invoice PDF once the document is VALID.
model EInvoice {
  id            String         @id @default(uuid()) @db.Uuid
  invoiceId     String         @unique @db.Uuid
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  condoId       String         @db.Uuid
  condo         Condo          @relation(fields: [condoId], references: [id], onDelete: Cascade)
  status        EInvoiceStatus @default(NOT_SUBMITTED)
  environment   String         @default("SANDBOX")
  lhdnUuid      String?
  lhdnLongId    String?
  submissionUid String?
  qrPayload     String?
  validationUrl String?
  documentJson  Json           @default("{}")
  validatedAt   DateTime?
  submittedAt   DateTime?
  cancelledAt   DateTime?
  errorMessage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([condoId, status])
  @@index([lhdnUuid])
  @@map("einvoices")
}

/// Per-condo Model Context Protocol (MCP) server connections for AI assistants
/// and automation. Secrets are envelope-encrypted; never returned to clients.
model McpServerConnection {
  id              String                  @id @default(uuid()) @db.Uuid
  condoId         String                  @db.Uuid
  condo           Condo                   @relation(fields: [condoId], references: [id], onDelete: Cascade)
  displayName     String
  transport       McpTransport            @default(STREAMABLE_HTTP)
  serverUrl       String?
  publicConfig    Json                    @default("{}")
  encryptedSecret Bytes?
  secretIv        Bytes?
  secretAuthTag   Bytes?
  keyVersion      Int                     @default(1)
  enabled         Boolean                 @default(false)
  lastTestStatus  McpConnectionTestStatus @default(UNTESTED)
  lastTestMessage String?
  lastTestedAt    DateTime?
  createdByUserId String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([condoId])
  @@map("mcp_server_connections")
}

/// Generic admin-visible automation history. Each scheduled/manual job writes
/// a run row so management can see what happened and what is currently running.
model AutomationRun {
  id                String              @id @default(uuid()) @db.Uuid
  condoId           String              @db.Uuid
  condo             Condo               @relation(fields: [condoId], references: [id], onDelete: Cascade)
  jobKey            AutomationJobKey
  stageName         String
  status            AutomationRunStatus @default(PENDING)
  scheduledFor      DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  summary           Json                @default("{}")
  errorMessage      String?
  triggeredByUserId String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([condoId, jobKey, createdAt])
  @@index([condoId, status, scheduledFor])
  @@map("automation_runs")
}

//////////////////////////////////////////////////////////////////////////////
// Defects / maintenance
//////////////////////////////////////////////////////////////////////////////

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DefectStatus {
  NEW
  ACK
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

model Defect {
  id              String         @id @default(uuid()) @db.Uuid
  condoId         String         @db.Uuid
  condo           Condo          @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId          String?        @db.Uuid
  unit            Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  raisedByUserId  String         @db.Uuid
  raisedBy        User           @relation("raisedBy", fields: [raisedByUserId], references: [id])
  category        String
  severity        DefectSeverity @default(MEDIUM)
  title           String
  description     String
  location        String?
  status          DefectStatus   @default(NEW)
  assignedToUserId String?       @db.Uuid
  assignedTo      User?          @relation("assignedTo", fields: [assignedToUserId], references: [id])
  // Handover inspection grouping: a Defect can be a line item of a parent
  // DefectReport. Nullable so standalone (ongoing-maintenance) defects keep working.
  reportId        String?        @db.Uuid
  report          DefectReport?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  // Optional taxonomy classification (Space -> Element -> Issue) for handover items.
  spaceTypeId     String?        @db.Uuid
  spaceType       DefectSpaceType? @relation(fields: [spaceTypeId], references: [id], onDelete: SetNull)
  elementId       String?        @db.Uuid
  element         DefectElement? @relation(fields: [elementId], references: [id], onDelete: SetNull)
  issueId         String?        @db.Uuid
  issue           DefectIssue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  // Concrete room label within the unit, e.g. "Bathroom 1".
  spaceLabel      String?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  updates     DefectUpdate[]
  attachments Attachment[]

  @@index([condoId, status])
  @@index([unitId])
  @@index([raisedByUserId])
  @@index([assignedToUserId])
  @@index([reportId])
  @@map("defects")
}

model DefectUpdate {
  id           String        @id @default(uuid()) @db.Uuid
  defectId     String        @db.Uuid
  defect       Defect        @relation(fields: [defectId], references: [id], onDelete: Cascade)
  authorUserId String        @db.Uuid
  author       User          @relation(fields: [authorUserId], references: [id])
  message      String
  statusFrom   DefectStatus?
  statusTo     DefectStatus?
  isInternal   Boolean       @default(false)
  createdAt    DateTime      @default(now())

  attachments Attachment[]

  @@index([defectId])
  @@map("defect_updates")
}

//////////////////////////////////////////////////////////////////////////////
// Attachments (S3 keys)
//////////////////////////////////////////////////////////////////////////////

enum AttachmentOwner {
  DEFECT
  DEFECT_UPDATE
  ANNOUNCEMENT
  THREAD_MESSAGE
  PROFILE
  GENERIC
  DOCUMENT_VERSION
}

enum AttachmentStatus {
  PENDING
  COMMITTED
}

enum TranscodeStatus {
  PENDING
  READY
  FAILED
}

model Attachment {
  id             String           @id @default(uuid()) @db.Uuid
  bucket         String
  key            String
  thumbnailKey   String?
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  status         AttachmentStatus @default(PENDING)
  ownerKind      AttachmentOwner
  uploadedByUserId String?        @db.Uuid
  uploadedBy     User?            @relation(fields: [uploadedByUserId], references: [id])
  defectId       String?          @db.Uuid
  defect         Defect?          @relation(fields: [defectId], references: [id], onDelete: Cascade)
  defectUpdateId String?          @db.Uuid
  defectUpdate   DefectUpdate?    @relation(fields: [defectUpdateId], references: [id], onDelete: Cascade)
  threadMessageId String?         @db.Uuid
  threadMessage  ThreadMessage?   @relation(fields: [threadMessageId], references: [id], onDelete: Cascade)
  announcementId String?          @db.Uuid
  announcement   Announcement?    @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  documentVersionId String?       @unique @db.Uuid
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  lostFoundPost     LostFoundPost?
  vendorBill        VendorBill?
  format               String?
  fallbackKey          String?
  fallbackMimeType     String?
  fallbackThumbnailKey String?
  transcodeStatus      TranscodeStatus @default(PENDING)
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  @@unique([bucket, key])
  @@index([defectId])
  @@index([defectUpdateId])
  @@index([threadMessageId])
  @@index([announcementId])
  @@index([documentVersionId])
  @@index([status, createdAt])
  @@map("attachments")
}

//////////////////////////////////////////////////////////////////////////////
// Announcements
//////////////////////////////////////////////////////////////////////////////

enum AnnouncementImportance {
  INFO
  IMPORTANT
  URGENT
}

enum AnnouncementCategory {
  NOTICE
  DOCUMENT
  MAINTENANCE
}

enum AnnouncementAudienceScope {
  CONDO
  BLOCKS
  UNITS
}

model Announcement {
  id            String                    @id @default(uuid()) @db.Uuid
  condoId       String                    @db.Uuid
  condo         Condo                     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  authorUserId  String                    @db.Uuid
  author        User                      @relation("announcementAuthor", fields: [authorUserId], references: [id])
  title         String
  body          String
  importance    AnnouncementImportance    @default(INFO)
  category      AnnouncementCategory      @default(NOTICE)
  audienceScope AnnouncementAudienceScope @default(CONDO)
  audience      Json                      @default("{}")
  publishedAt   DateTime?
  expiresAt     DateTime?
  // Set once the "published" push has gone out. Guards against double-notifying
  // when a scheduled notice goes live (sweeper) vs. immediate publish.
  notifiedAt    DateTime?
  requiresAck   Boolean                   @default(false)
  pinned        Boolean                   @default(false)
  metadata      Json                      @default("{}")
  deletedAt     DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  acks        AnnouncementAck[]
  reads       AnnouncementRead[]
  blocks      AnnouncementBlock[]
  units       AnnouncementUnit[]
  attachments Attachment[]

  @@index([condoId, publishedAt])
  @@index([condoId, category, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

model AnnouncementBlock {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  blockId        String       @db.Uuid
  block          Block        @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([announcementId, blockId])
  @@index([blockId])
  @@map("announcement_blocks")
}

model AnnouncementUnit {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  unitId         String       @db.Uuid
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([announcementId, unitId])
  @@index([unitId])
  @@map("announcement_units")
}

model AnnouncementAck {
  id              String       @id @default(uuid()) @db.Uuid
  announcementId  String       @db.Uuid
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId          String       @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt  DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_acks")
}

//////////////////////////////////////////////////////////////////////////////
// Notifications & push
//////////////////////////////////////////////////////////////////////////////

enum NotificationKind {
  VISITOR_REQUEST
  VISITOR_WALK_IN_REQUEST
  VISITOR_CHECKED_IN
  VISITOR_CHECKED_OUT
  INVOICE_ISSUED
  INVOICE_DUE_SOON
  INVOICE_PAID
  DEFECT_UPDATE
  ANNOUNCEMENT
  ACCESS_GRANTED
  ACCESS_REVOKED
  AUDIT_ALERT
  THREAD_MESSAGE
  THREAD_ASSIGNED
  THREAD_STATUS
  THREAD_SLA_ESCALATION
  PARCEL_RECEIVED
  PARCEL_OVERDUE
  LOST_FOUND_POST
  FORM_SUBMITTED
  FORM_APPROVED
  FORM_REJECTED
  DOCUMENT_PUBLISHED
  MEETING_NOTICE_PUBLISHED
  PROXY_RECEIVED
  RESOLUTION_OPEN
  SYSTEM
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          NotificationKind
  title         String
  body          String
  data          Json             @default("{}")
  readAt        DateTime?
  sentChannels  Json             @default("[]")
  createdAt     DateTime         @default(now())

  @@index([userId, readAt])
  // List feed is ordered by createdAt desc per user.
  @@index([userId, createdAt])
  @@map("notifications")
}

enum PushKind {
  EXPO
  WEB
}

model PushSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        PushKind
  token       String
  deviceInfo  Json     @default("{}")
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  revokedAt   DateTime?

  @@unique([kind, token])
  @@index([userId])
  @@map("push_subscriptions")
}

//////////////////////////////////////////////////////////////////////////////
// Audit log
//////////////////////////////////////////////////////////////////////////////

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  LOGIN
  LOGOUT
  GRANT_ACCESS
  REVOKE_ACCESS
  PAYMENT
  APPROVE
  REJECT
  ACK
  EXPORT
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  condoId      String?     @db.Uuid
  condo        Condo?      @relation(fields: [condoId], references: [id], onDelete: SetNull)
  unitId       String?     @db.Uuid
  unit         Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  actorUserId  String?     @db.Uuid
  actor        User?       @relation("auditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole    RoleId?
  action       AuditAction
  resourceType String
  resourceId   String?
  metadata     Json        @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@index([condoId, createdAt])
  @@index([unitId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

//////////////////////////////////////////////////////////////////////////////
// Communication threads (resident <-> management) + SLA
//////////////////////////////////////////////////////////////////////////////

enum ThreadCategory {
  BILLING
  MAINTENANCE
  FACILITY
  SECURITY
  COMPLAINT
  SUGGESTION
  GOVERNANCE
  GENERAL
}

enum ThreadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ThreadStatus {
  OPEN
  AWAITING_RESIDENT
  AWAITING_MANAGEMENT
  PENDING_RESIDENT_CONFIRMATION
  RESOLVED
  CLOSED
  REOPENED
}

enum ThreadMessageKind {
  MESSAGE
  INTERNAL_NOTE
  SYSTEM
}

model Thread {
  id                 String         @id @default(uuid()) @db.Uuid
  condoId            String         @db.Uuid
  condo              Condo          @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId             String?        @db.Uuid
  unit               Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdByUserId    String         @db.Uuid
  createdBy          User           @relation("threadCreatedBy", fields: [createdByUserId], references: [id])
  assignedToUserId   String?        @db.Uuid
  assignedTo         User?          @relation("threadAssignedTo", fields: [assignedToUserId], references: [id])
  subject            String
  category           ThreadCategory @default(GENERAL)
  priority           ThreadPriority @default(NORMAL)
  status             ThreadStatus   @default(OPEN)
  slaPolicyId        String?        @db.Uuid
  slaPolicy          SlaPolicy?     @relation(fields: [slaPolicyId], references: [id])
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  // Resident-driven resolution (D2/M1): management proposes, resident confirms.
  resolutionProposedAt       DateTime?
  resolutionProposedByUserId String?  @db.Uuid
  resolutionProposedMessageId String? @db.Uuid
  resolutionProposedMessage   ThreadMessage? @relation("ProposedSolution", fields: [resolutionProposedMessageId], references: [id], onDelete: SetNull)
  reopenCount        Int            @default(0)
  lastMessageAt      DateTime       @default(now())
  metadata           Json           @default("{}")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  messages     ThreadMessage[]
  participants ThreadParticipant[]

  @@index([condoId, status])
  @@index([unitId])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([priority])
  @@map("threads")
}

model ThreadMessage {
  id           String            @id @default(uuid()) @db.Uuid
  threadId     String            @db.Uuid
  thread       Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String            @db.Uuid
  author       User              @relation("threadMessageAuthor", fields: [authorUserId], references: [id])
  kind         ThreadMessageKind @default(MESSAGE)
  body         String
  editedAt     DateTime?
  createdAt    DateTime          @default(now())

  attachments Attachment[]
  proposedSolutionForThreads Thread[] @relation("ProposedSolution")

  // Per-thread transcript reads are ordered by createdAt asc.
  @@index([threadId, createdAt])
  @@map("thread_messages")
}

model ThreadParticipant {
  id         String    @id @default(uuid()) @db.Uuid
  threadId   String    @db.Uuid
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation("threadParticipant", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

model SlaPolicy {
  id                String         @id @default(uuid()) @db.Uuid
  condoId           String         @db.Uuid
  condo             Condo          @relation(fields: [condoId], references: [id], onDelete: Cascade)
  priority          ThreadPriority
  firstResponseMins Int
  resolutionMins    Int
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  threads Thread[]

  @@unique([condoId, priority])
  @@map("sla_policies")
}

//////////////////////////////////////////////////////////////////////////////
// FAQ (management-curated knowledge base)
//////////////////////////////////////////////////////////////////////////////

model FaqCategory {
  id        String   @id @default(uuid()) @db.Uuid
  condoId   String   @db.Uuid
  condo     Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles FaqArticle[]

  @@index([condoId])
  @@map("faq_categories")
}

model FaqArticle {
  id           String       @id @default(uuid()) @db.Uuid
  condoId      String       @db.Uuid
  condo        Condo        @relation(fields: [condoId], references: [id], onDelete: Cascade)
  categoryId   String?      @db.Uuid
  category     FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  question     String
  answer       String
  tags         String[]
  published    Boolean      @default(false)
  pinned       Boolean      @default(false)
  position     Int          @default(0)
  viewCount    Int          @default(0)
  helpfulCount Int          @default(0)
  authorUserId String?      @db.Uuid
  author       User?        @relation("faqAuthor", fields: [authorUserId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([condoId, published])
  @@index([categoryId])
  @@map("faq_articles")
}

//////////////////////////////////////////////////////////////////////////////
// Unit types, room templates & handover defect taxonomy
//////////////////////////////////////////////////////////////////////////////

enum DefectReportKind {
  HANDOVER
  STANDARD
}

/// A reusable unit layout (e.g. "Type A — 3 bed") with a template of rooms.
model UnitType {
  id          String   @id @default(uuid()) @db.Uuid
  condoId     String   @db.Uuid
  condo       Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spaces  UnitTypeSpace[]
  units   Unit[]
  feeRate UnitTypeFeeRate?

  @@index([condoId])
  @@map("unit_types")
}

/// A concrete room within a unit type, e.g. "Bathroom 1", typed by a space type.
model UnitTypeSpace {
  id          String           @id @default(uuid()) @db.Uuid
  unitTypeId  String           @db.Uuid
  unitType    UnitType         @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)
  spaceTypeId String?          @db.Uuid
  spaceType   DefectSpaceType? @relation(fields: [spaceTypeId], references: [id], onDelete: SetNull)
  name        String
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([unitTypeId])
  @@index([spaceTypeId])
  @@map("unit_type_spaces")
}

/// Top of the defect taxonomy: a kind of space, e.g. "Bathroom", "Kitchen".
model DefectSpaceType {
  id        String   @id @default(uuid()) @db.Uuid
  condoId   String   @db.Uuid
  condo     Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elements   DefectElement[]
  unitSpaces UnitTypeSpace[]
  defects    Defect[]

  @@index([condoId])
  @@map("defect_space_types")
}

/// A checkable element within a space type, e.g. "Tiles", "Tap", "Door".
model DefectElement {
  id          String          @id @default(uuid()) @db.Uuid
  condoId     String          @db.Uuid
  condo       Condo           @relation(fields: [condoId], references: [id], onDelete: Cascade)
  spaceTypeId String          @db.Uuid
  spaceType   DefectSpaceType @relation(fields: [spaceTypeId], references: [id], onDelete: Cascade)
  name        String
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  issues  DefectIssue[]
  defects Defect[]

  @@index([condoId])
  @@index([spaceTypeId])
  @@map("defect_elements")
}

/// A specific issue for an element, e.g. "Uneven tiles", "Leaking".
model DefectIssue {
  id        String        @id @default(uuid()) @db.Uuid
  condoId   String        @db.Uuid
  condo     Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  elementId String        @db.Uuid
  element   DefectElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  name      String
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  defects Defect[]

  @@index([condoId])
  @@index([elementId])
  @@map("defect_issues")
}

/// Parent ticket grouping many Defect line items (e.g. one handover inspection).
model DefectReport {
  id             String           @id @default(uuid()) @db.Uuid
  condoId        String           @db.Uuid
  condo          Condo            @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId         String?          @db.Uuid
  unit           Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  raisedByUserId String           @db.Uuid
  raisedBy       User             @relation("reportRaisedBy", fields: [raisedByUserId], references: [id])
  kind           DefectReportKind @default(HANDOVER)
  title          String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  defects Defect[]

  @@index([condoId, createdAt])
  @@index([unitId])
  @@map("defect_reports")
}

//////////////////////////////////////////////////////////////////////////////
// Owner-verified governance polls (MC consultation)
//////////////////////////////////////////////////////////////////////////////

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}

enum PollAudienceScope {
  ALL_OWNERS
  BLOCK
}

model Poll {
  id              String            @id @default(uuid()) @db.Uuid
  condoId         String            @db.Uuid
  condo           Condo             @relation(fields: [condoId], references: [id], onDelete: Cascade)
  title           String
  description     String            @default("")
  status          PollStatus        @default(DRAFT)
  opensAt         DateTime?
  closesAt        DateTime?
  createdByUserId String            @db.Uuid
  createdBy       User              @relation("pollAuthor", fields: [createdByUserId], references: [id])
  audienceScope   PollAudienceScope @default(ALL_OWNERS)
  /// When audienceScope is BLOCK, JSON array of block UUID strings.
  blockIds        Json              @default("[]")
  settings        Json              @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  options PollOption[]
  votes   PollVote[]
  meetingResolution MeetingResolution?

  @@index([condoId, status])
  @@index([condoId, createdAt])
  @@map("polls")
}

//////////////////////////////////////////////////////////////////////////////
// Governance v0.6 — AGM/EGM meetings, proxies, resolution voting via Poll
//////////////////////////////////////////////////////////////////////////////

enum GeneralMeetingKind {
  AGM
  EGM
}

enum GeneralMeetingStatus {
  DRAFT
  NOTICE_PUBLISHED
  IN_PROGRESS
  CLOSED
}

model GeneralMeeting {
  id              String               @id @default(uuid()) @db.Uuid
  condoId         String               @db.Uuid
  condo           Condo                @relation(fields: [condoId], references: [id], onDelete: Cascade)
  kind            GeneralMeetingKind
  title           String
  scheduledAt     DateTime
  noticeBody          String               @default("")
  minutesBody         String               @default("")
  minutesPublishedAt  DateTime?
  financialSnapshot   Json?
  status              GeneralMeetingStatus @default(DRAFT)
  createdByUserId     String               @db.Uuid
  createdBy       User                 @relation("meetingAuthor", fields: [createdByUserId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  resolutions MeetingResolution[]
  proxies     MeetingProxy[]

  @@index([condoId, status])
  @@index([condoId, scheduledAt])
  @@map("general_meetings")
}

model MeetingProxy {
  id                 String         @id @default(uuid()) @db.Uuid
  meetingId          String         @db.Uuid
  meeting            GeneralMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  unitId             String         @db.Uuid
  unit               Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  ownerUserId        String         @db.Uuid
  owner              User           @relation("proxyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  proxyHolderUserId  String?        @db.Uuid
  proxyHolder        User?          @relation("proxyHolder", fields: [proxyHolderUserId], references: [id], onDelete: SetNull)
  proxyHolderName    String
  proxyHolderContact String         @default("")
  submittedAt        DateTime       @default(now())

  @@unique([meetingId, unitId])
  @@index([meetingId])
  @@index([ownerUserId])
  @@index([proxyHolderUserId])
  @@map("meeting_proxies")
}

model MeetingResolution {
  id             String         @id @default(uuid()) @db.Uuid
  meetingId      String         @db.Uuid
  meeting        GeneralMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title          String
  description    String         @default("")
  /// Linked Poll for share-weighted owner voting (For / Against / Abstain).
  pollId         String?        @unique @db.Uuid
  poll           Poll?          @relation(fields: [pollId], references: [id], onDelete: SetNull)
  votingOpensAt  DateTime?
  votingClosesAt DateTime?
  resultsSnapshot Json?
  position       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([meetingId])
  @@map("meeting_resolutions")
}

model PollOption {
  id       String @id @default(uuid()) @db.Uuid
  pollId   String @db.Uuid
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  position Int    @default(0)

  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id          String    @id @default(uuid()) @db.Uuid
  pollId      String    @db.Uuid
  poll        Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId    String    @db.Uuid
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  unitId      String    @db.Uuid
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownershipId String    @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)
  /// Snapshot of sharePercent at vote time for future weighted AGM results.
  weight      Decimal   @db.Decimal(6, 3)
  createdAt   DateTime  @default(now())

  @@unique([pollId, unitId])
  @@index([pollId])
  @@index([userId])
  @@map("poll_votes")
}

//////////////////////////////////////////////////////////////////////////////
// Facility / amenity booking (§4.6)
//////////////////////////////////////////////////////////////////////////////

/// A bookable shared amenity (function hall, BBQ pit, gym, pool, court, surau…).
/// Availability is a simple daily window (openTime→closeTime) split into
/// fixed-length slots; `maxConcurrent` allows N simultaneous bookings per slot
/// (e.g. multiple BBQ pits under one facility record).
model Facility {
  id               String    @id @default(uuid()) @db.Uuid
  condoId          String    @db.Uuid
  condo            Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  capacity         Int?
  requiresApproval Boolean   @default(false)
  /// Per-slot fee invoiced on confirmation (null/0 = free).
  bookingFee       Decimal?  @db.Decimal(14, 2)
  /// Refundable deposit held on confirmation (null/0 = none).
  depositAmount    Decimal?  @db.Decimal(14, 2)
  /// Daily availability window in 24h HH:mm local time.
  openTime         String    @default("08:00")
  closeTime        String    @default("22:00")
  slotMinutes      Int       @default(60)
  maxConcurrent    Int       @default(1)
  active           Boolean   @default(true)
  position         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookings Booking[]

  @@index([condoId, active])
  @@map("facilities")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  facilityId       String        @db.Uuid
  facility         Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  condoId          String        @db.Uuid
  condo            Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId           String?       @db.Uuid
  unit             Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  startAt          DateTime
  endAt            DateTime
  status           BookingStatus @default(PENDING)
  /// Fee/deposit amounts snapshotted at confirmation time.
  fee              Decimal       @default(0) @db.Decimal(14, 2)
  depositHeld      Decimal       @default(0) @db.Decimal(14, 2)
  /// Loose links into the billing system (no FK to keep billing models lean).
  invoiceId        String?       @db.Uuid
  depositId        String?       @db.Uuid
  notes            String?
  reviewedByUserId String?       @db.Uuid
  reviewedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([facilityId, startAt])
  @@index([condoId, status])
  @@index([userId])
  @@index([unitId])
  @@map("bookings")
}

//////////////////////////////////////////////////////////////////////////////
// Guard safety: panic / SOS + patrol checkpoint tours
//////////////////////////////////////////////////////////////////////////////

enum SosKind {
  MEDICAL
  SECURITY
  FIRE
  GENERAL
}

enum SosStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

/// A panic / SOS alert raised by a resident (or any condo member). Fans out to
/// management + guards instantly (realtime + push) so help can be dispatched.
model SosAlert {
  id                   String    @id @default(uuid()) @db.Uuid
  condoId              String    @db.Uuid
  condo                Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  raisedByUserId       String    @db.Uuid
  raisedBy             User      @relation("sosRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Cascade)
  unitId               String?   @db.Uuid
  unit                 Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  kind                 SosKind   @default(GENERAL)
  status               SosStatus @default(ACTIVE)
  locationNote         String?
  lat                  Float?
  lng                  Float?
  acknowledgedByUserId String?   @db.Uuid
  acknowledgedBy       User?     @relation("sosAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  acknowledgedAt       DateTime?
  resolvedByUserId     String?   @db.Uuid
  resolvedBy           User?     @relation("sosResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  resolutionNote       String?
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([condoId, status])
  @@index([condoId, createdAt])
  @@index([raisedByUserId])
  @@map("sos_alerts")
}

/// A physical patrol checkpoint identified by a QR token (`code`). Guards scan
/// the code during rounds; management CRUDs checkpoints and monitors coverage.
model PatrolCheckpoint {
  id                      String        @id @default(uuid()) @db.Uuid
  condoId                 String        @db.Uuid
  condo                   Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name                    String
  description             String?
  /// Opaque QR token scanned by guards; unique per condo scope (globally unique).
  code                    String        @unique
  active                  Boolean       @default(true)
  position                Int           @default(0)
  /// Expected max minutes between scans; null disables overdue detection.
  expectedIntervalMinutes Int?
  /// De-dupes overdue notifications so management isn't spammed each sweep.
  lastOverdueNotifiedAt   DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  scans PatrolScan[]

  @@index([condoId, active])
  @@map("patrol_checkpoints")
}

enum PatrolScanSource {
  ONLINE
  OFFLINE
}

/// A recorded checkpoint scan by a guard during a patrol round.
model PatrolScan {
  id           String           @id @default(uuid()) @db.Uuid
  checkpointId String           @db.Uuid
  checkpoint   PatrolCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  condoId      String           @db.Uuid
  condo        Condo            @relation(fields: [condoId], references: [id], onDelete: Cascade)
  guardUserId  String           @db.Uuid
  guard        User             @relation("patrolScanGuard", fields: [guardUserId], references: [id], onDelete: Cascade)
  scannedAt    DateTime         @default(now())
  lat          Float?
  lng          Float?
  note         String?
  source       PatrolScanSource @default(ONLINE)
  createdAt    DateTime         @default(now())

  @@index([condoId, scannedAt])
  @@index([checkpointId, scannedAt])
  @@index([guardUserId, scannedAt])
  @@map("patrol_scans")
}

//////////////////////////////////////////////////////////////////////////////
// Parcels / deliveries (guard log → resident notify → collection sign-off)
//////////////////////////////////////////////////////////////////////////////

enum ParcelStatus {
  RECEIVED
  NOTIFIED
  COLLECTED
  OVERDUE
}

/// Incoming parcel logged by a guard at the lobby. Residents are notified to
/// collect; uncollected parcels are flagged overdue by a scheduled sweep.
model Parcel {
  id                    String       @id @default(uuid()) @db.Uuid
  condoId               String       @db.Uuid
  condo                 Condo        @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId                String       @db.Uuid
  unit                  Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  recipientName         String
  carrier               String?
  trackingRef           String?
  status                ParcelStatus @default(RECEIVED)
  receivedAt            DateTime     @default(now())
  collectedAt           DateTime?
  receivedByGuardId     String       @db.Uuid
  receivedByGuard       User         @relation("parcelReceivedByGuard", fields: [receivedByGuardId], references: [id], onDelete: Cascade)
  collectedByUserId     String?      @db.Uuid
  collectedBy           User?        @relation("parcelCollectedBy", fields: [collectedByUserId], references: [id], onDelete: SetNull)
  photoUrl              String?
  notes                 String?
  /// De-dupes overdue reminder notifications (daily re-nudge at most).
  lastOverdueNotifiedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([condoId, status])
  @@index([unitId, status])
  @@index([condoId, receivedAt])
  @@map("parcels")
}

//////////////////////////////////////////////////////////////////////////////
// Lost & found board (non-commercial community posts)
//////////////////////////////////////////////////////////////////////////////

enum LostFoundKind {
  LOST
  FOUND
}

enum LostFoundStatus {
  OPEN
  RESOLVED
  REMOVED
}

/// Resident-posted lost or found item for the condo community board.
model LostFoundPost {
  id                String          @id @default(uuid()) @db.Uuid
  condoId           String          @db.Uuid
  condo             Condo           @relation(fields: [condoId], references: [id], onDelete: Cascade)
  userId            String          @db.Uuid
  user              User            @relation("lostFoundAuthor", fields: [userId], references: [id], onDelete: Cascade)
  unitId            String          @db.Uuid
  unit              Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind              LostFoundKind
  title             String
  description       String
  locationNote      String?
  contactMethod     String
  status            LostFoundStatus @default(OPEN)
  photoAttachmentId String?         @unique @db.Uuid
  photoAttachment   Attachment?     @relation(fields: [photoAttachmentId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([condoId, status])
  @@index([condoId, kind, status])
  @@index([userId])
  @@index([unitId])
  @@map("lost_found_posts")
}

//////////////////////////////////////////////////////////////////////////////
// Condo forms & workflows (move-in/out, renovation, vehicle sticker…)
//////////////////////////////////////////////////////////////////////////////

enum FormTemplateKind {
  MOVE_IN
  MOVE_OUT
  RENOVATION
  VEHICLE_STICKER
  CUSTOM
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Management-configurable form template with a JSON field schema.
model FormTemplate {
  id        String           @id @default(uuid()) @db.Uuid
  condoId   String           @db.Uuid
  condo     Condo            @relation(fields: [condoId], references: [id], onDelete: Cascade)
  kind      FormTemplateKind
  title     String
  /// JSON schema: { fields: [{ id, type, label, required?, options? }] }
  fields    Json             @default("{}")
  active    Boolean          @default(true)
  position  Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  submissions FormSubmission[]

  @@index([condoId, active])
  @@map("form_templates")
}

/// A resident's filled-in form awaiting management review.
model FormSubmission {
  id               String               @id @default(uuid()) @db.Uuid
  templateId       String               @db.Uuid
  template         FormTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  condoId          String               @db.Uuid
  condo            Condo                @relation(fields: [condoId], references: [id], onDelete: Cascade)
  unitId           String               @db.Uuid
  unit             Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId           String               @db.Uuid
  user             User                 @relation("formSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  status           FormSubmissionStatus @default(DRAFT)
  answers          Json                 @default("{}")
  reviewedByUserId String?              @db.Uuid
  reviewedBy       User?                @relation("formReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?
  submittedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([condoId, status])
  @@index([userId])
  @@index([unitId])
  @@index([templateId])
  @@map("form_submissions")
}


//////////////////////////////////////////////////////////////////////////////
// Documents vault (house rules, AGM minutes, bylaws, circulars)
//////////////////////////////////////////////////////////////////////////////

enum DocumentFolderAudience {
  ALL
  OWNERS
  MANAGEMENT
}

/// Role-scoped folder for condo document library entries.
model DocumentFolder {
  id        String                 @id @default(uuid()) @db.Uuid
  condoId   String                 @db.Uuid
  condo     Condo                  @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name      String
  audience  DocumentFolderAudience @default(ALL)
  position  Int                    @default(0)
  active    Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  documents Document[]

  @@index([condoId, active])
  @@map("document_folders")
}

/// A logical document (e.g. house rules) with versioned file uploads.
model Document {
  id               String           @id @default(uuid()) @db.Uuid
  folderId         String           @db.Uuid
  folder           DocumentFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  condoId          String           @db.Uuid
  condo            Condo            @relation(fields: [condoId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  currentVersionId String?          @unique @db.Uuid
  currentVersion   DocumentVersion? @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  versions DocumentVersion[] @relation("DocumentVersions")

  @@index([condoId, folderId])
  @@index([folderId])
  @@map("documents")
}

/// Immutable published file revision for a document.
model DocumentVersion {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @db.Uuid
  document         Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor       Document? @relation("DocumentCurrentVersion")
  versionNumber    Int
  fileKey          String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String   @db.Uuid
  uploadedBy       User     @relation("documentVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  publishedAt      DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())

  attachment Attachment?

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

//////////////////////////////////////////////////////////////////////////////
// General ledger (double-entry) & bank reconciliation
//////////////////////////////////////////////////////////////////////////////

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum GlJournalSourceType {
  INVOICE
  PAYMENT
  MANUAL
  REVERSAL
  VENDOR_BILL
  VENDOR_PAYMENT
}

enum VendorBillStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

/// Supplier / contractor master list for accounts payable.
model Vendor {
  id        String   @id @default(uuid()) @db.Uuid
  condoId   String   @db.Uuid
  condo     Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  taxId     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills VendorBill[]

  @@index([condoId, active])
  @@map("vendors")
}

/// Vendor invoice awaiting approval and payment — management-only AP workflow.
model VendorBill {
  id                String           @id @default(uuid()) @db.Uuid
  condoId           String           @db.Uuid
  condo             Condo            @relation(fields: [condoId], references: [id], onDelete: Cascade)
  vendorId          String           @db.Uuid
  vendor            Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  billNumber        String
  billDate          DateTime         @db.Date
  dueDate           DateTime         @db.Date
  amount            Decimal          @db.Decimal(14, 2)
  fund              LedgerFund
  status            VendorBillStatus @default(DRAFT)
  description       String?
  attachmentId      String?          @unique @db.Uuid
  attachment        Attachment?      @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  approvedByUserId  String?          @db.Uuid
  approvedBy        User?            @relation("vendorBillApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  paidAt            DateTime?
  glJournalEntryId  String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([condoId, billNumber])
  @@index([condoId, status])
  @@index([condoId, fund])
  @@index([condoId, vendorId])
  @@map("vendor_bills")
}

/// Chart of accounts — one tree per condo, seeded from Malaysian JMB template.
model GlAccount {
  id        String        @id @default(uuid()) @db.Uuid
  condoId   String        @db.Uuid
  condo     Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      GlAccountType
  fund      LedgerFund    @default(GENERAL)
  parentId  String?       @db.Uuid
  parent    GlAccount?    @relation("GlAccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  GlAccount[]   @relation("GlAccountHierarchy")
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  journalLines         GlJournalLine[]
  bankStatementImports BankStatementImport[]

  @@unique([condoId, code])
  @@index([condoId, type])
  @@index([condoId, fund])
  @@map("gl_accounts")
}

/// A balanced double-entry journal voucher.
model GlJournalEntry {
  id             String              @id @default(uuid()) @db.Uuid
  condoId        String              @db.Uuid
  condo          Condo               @relation(fields: [condoId], references: [id], onDelete: Cascade)
  entryDate      DateTime            @db.Date
  description    String
  sourceType     GlJournalSourceType
  sourceId       String?
  postedByUserId String?             @db.Uuid
  postedBy       User?               @relation("glJournalPoster", fields: [postedByUserId], references: [id], onDelete: SetNull)
  idempotencyKey String?
  createdAt      DateTime            @default(now())

  lines GlJournalLine[]

  @@unique([idempotencyKey])
  @@index([condoId, entryDate])
  @@index([condoId, sourceType, sourceId])
  @@map("gl_journal_entries")
}

/// Debit/credit line within a journal entry. Fund tag keeps maintenance vs
/// sinking fund separate for Strata Management Act reporting.
model GlJournalLine {
  id             String         @id @default(uuid()) @db.Uuid
  journalEntryId String         @db.Uuid
  journalEntry   GlJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String         @db.Uuid
  account        GlAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal        @default(0) @db.Decimal(14, 2)
  credit         Decimal        @default(0) @db.Decimal(14, 2)
  fund           LedgerFund     @default(GENERAL)
  memo           String?

  bankStatementMatches BankStatementLine[]

  @@index([journalEntryId])
  @@index([accountId])
  @@index([accountId, fund])
  @@map("gl_journal_lines")
}

/// Imported bank statement for reconciliation against the GL cash account.
model BankStatementImport {
  id               String    @id @default(uuid()) @db.Uuid
  condoId          String    @db.Uuid
  condo            Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  accountId        String    @db.Uuid
  account          GlAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodStart      DateTime  @db.Date
  periodEnd        DateTime  @db.Date
  openingBalance   Decimal   @db.Decimal(14, 2)
  closingBalance   Decimal   @db.Decimal(14, 2)
  importedAt       DateTime  @default(now())
  importedByUserId String?   @db.Uuid
  importedBy       User?     @relation("bankStatementImporter", fields: [importedByUserId], references: [id], onDelete: SetNull)

  lines BankStatementLine[]

  @@index([condoId, accountId])
  @@index([condoId, periodStart, periodEnd])
  @@map("bank_statement_imports")
}

/// Single line from a bank CSV import, optionally matched to a GL journal line.
model BankStatementLine {
  id                   String              @id @default(uuid()) @db.Uuid
  importId             String              @db.Uuid
  import               BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  date                 DateTime            @db.Date
  description          String
  amount               Decimal             @db.Decimal(14, 2)
  matchedJournalLineId String?             @db.Uuid
  matchedJournalLine   GlJournalLine?      @relation(fields: [matchedJournalLineId], references: [id], onDelete: SetNull)

  @@index([importId, date])
  @@index([matchedJournalLineId])
  @@map("bank_statement_lines")
}
