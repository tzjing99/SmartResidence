{
  "extends": "@smartresidence/config-tsconfig/nestjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@smartresidence/shared-types": ["../../packages/shared-types/dist/index.d.ts"],
      "@smartresidence/shared-types/*": ["../../packages/shared-types/dist/*"]
    },
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*", "prisma/seed.ts", "scripts/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
