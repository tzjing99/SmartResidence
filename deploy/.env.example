# =============================================================================
# SmartResidence — local Docker / self-host stack environment
# Copy to deploy/.env before `docker compose up`.
#
# The placeholder values work for a localhost-only demo. Replace every
# "change-me" / "replace-with" value before exposing the stack to a network.
# Used by the root compose.yaml and deploy/docker-compose.selfhost.yml.
# =============================================================================

# --- Images / build -----------------------------------------------------------
# Tag applied to the locally built api/web images.
SR_IMAGE_TAG=local

# --- Public URLs (change to your domain when behind TLS) ----------------------
# Where the browser reaches the web app and where the web app reaches the API.
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Show the demo credentials and one-click fill on the sign-in screen.
# Set false before a real deployment.
SHOW_DEMO_CREDENTIALS=true

# --- Datastores (internal to the compose network) -----------------------------
POSTGRES_USER=smartresidence
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=smartresidence
# DATABASE_URL is assembled from the above in the compose file.

# Redis has no password by default on the internal network. Set one and add it
# to REDIS_URL if you expose Redis beyond the compose network.

# --- Object storage (MinIO in-stack; swap for S3/R2 in cloud) -----------------
S3_REGION=us-east-1
S3_BUCKET=sr-uploads
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-pass
S3_USE_PATH_STYLE=true

# --- Auth / crypto secrets (GENERATE THESE — never reuse the samples) ---------
# 32+ byte random strings. e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-32-byte-random-string
# 32-byte key that envelope-encrypts per-condo payment gateway credentials at rest.
BILLING_ENCRYPTION_KEY=replace-with-32-byte-random-key

# Cookie domain for sessions (bare host or your domain; no scheme).
SESSION_COOKIE_DOMAIN=localhost

# --- Email (Mailpit in-stack for trials; swap for Resend/SES in prod) ---------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartResidence <noreply@smartresidence.local>
RESEND_API_KEY=

# --- WhatsApp / SMS (optional — Twilio-backed seam) ---------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Payments (optional — Stripe global; MY rails configured per-condo in UI) -
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Locale defaults (Malaysia-first) -----------------------------------------
DEFAULT_CONDO_LOCALE=en
DEFAULT_CONDO_CURRENCY=MYR
DEFAULT_CONDO_TIMEZONE=Asia/Kuala_Lumpur

# --- Runtime ------------------------------------------------------------------
LOG_LEVEL=info
