# syntax=docker/dockerfile:1.7
#
# HEIC/HEIF decoding note:
#   sharp's prebuilt binaries can ENCODE AVIF but CANNOT DECODE HEIC (HEVC is
#   patent-encumbered). To decode iPhone HEIC uploads in production we build
#   sharp against a *global* libvips that is compiled with libheif + libde265.
#   Debian's `libvips42` ships with HEIF support, so we install `libvips-dev`
#   (build) / `libvips42` (runtime) and set SHARP_FORCE_GLOBAL_LIBVIPS=1.
#
#   On Windows dev machines sharp uses its prebuilt libvips WITHOUT libheif, so
#   HEIC uploads there hit the graceful fallback (stored as-is, transcode marked
#   SKIPPED). This is acceptable because the mobile app already pre-converts
#   HEIC -> JPEG client-side; only desktop-web HEIC is affected in local dev.
#   Verify HEIF support in a built image with: `node -e "console.log(require('sharp').format.heif)"`.
FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo

# --- deps -----------------------------------------------------------------
FROM base AS deps
# Toolchain + global libvips (with libheif/libde265) so sharp builds against it.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential python3 pkg-config \
      libvips-dev libheif-dev libde265-dev \
 && rm -rf /var/lib/apt/lists/*
ENV SHARP_FORCE_GLOBAL_LIBVIPS=1
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages packages
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm fetch
RUN pnpm install --frozen-lockfile --filter @smartresidence/api...

# --- build ----------------------------------------------------------------
FROM deps AS build
COPY apps/api apps/api
RUN pnpm --filter @smartresidence/api exec prisma generate \
 && pnpm --filter @smartresidence/api build

# --- runtime --------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
# Runtime libvips (with HEIF loaders) for the sharp pipeline + transcode worker.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libvips42 libheif1 libde265-0 \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV SHARP_FORCE_GLOBAL_LIBVIPS=1
WORKDIR /app
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/apps/api/prisma ./prisma
COPY --from=build /repo/apps/api/package.json ./package.json
COPY --from=build /repo/packages ./packages
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
