# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base
RUN apk add --no-cache openssl \
 && corepack enable \
 && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo

# --- deps -----------------------------------------------------------------
FROM base AS deps
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/api apps/api
COPY packages packages
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm fetch
# Only the API and shared workspace packages are present in this reduced
# context, so a full offline install creates reliable workspace links.
RUN pnpm install --frozen-lockfile --offline

# --- build ----------------------------------------------------------------
FROM deps AS build
# prebuild also builds shared-types; keep an explicit step for clearer Docker logs.
RUN pnpm --filter @smartresidence/shared-types build
RUN pnpm --filter @smartresidence/api exec prisma generate \
 && pnpm --filter @smartresidence/api build

# --- runtime --------------------------------------------------------------
FROM node:22-alpine AS runtime
RUN apk add --no-cache openssl \
 && corepack enable \
 && corepack prepare pnpm@9.12.0 --activate
ENV NODE_ENV=production
WORKDIR /app/apps/api
# Preserve the pnpm workspace layout so app-level links continue to point at
# /app/packages and the virtual store remains available at /app/node_modules.
COPY --from=build /repo/node_modules /app/node_modules
COPY --from=build /repo/apps/api/node_modules ./node_modules
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/apps/api/prisma ./prisma
COPY --from=build /repo/apps/api/ml-models ./ml-models
COPY --from=build /repo/apps/api/package.json ./package.json
COPY --from=build /repo/packages /app/packages
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
