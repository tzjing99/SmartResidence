{
  "name": "@smartresidence/api-client",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Typed REST client + React Query hooks for the SmartResidence API.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "scripts": {
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ./openapi/openapi.json -o ./src/generated/schema.ts"
  },
  "dependencies": {
    "@smartresidence/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.59.20",
    "socket.io-client": "^4.8.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@smartresidence/config-tsconfig": "workspace:*",
    "@types/react": "^18.3.12",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3"
  }
}
