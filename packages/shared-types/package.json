{
  "name": "@smartresidence/shared-types",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Zod schemas + inferred TypeScript types shared by the SmartResidence apps.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./visitor": {
      "types": "./dist/visitor.d.ts",
      "default": "./dist/visitor.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "default": "./dist/phone.js"
    },
    "./walk-in-owner": {
      "types": "./dist/walk-in-owner.d.ts",
      "default": "./dist/walk-in-owner.js"
    },
    "./unit-search": {
      "types": "./dist/unit-search.d.ts",
      "default": "./dist/unit-search.js"
    },
    "./billing": {
      "types": "./dist/billing.d.ts",
      "default": "./dist/billing.js"
    },
    "./defect": {
      "types": "./dist/defect.d.ts",
      "default": "./dist/defect.js"
    },
    "./announcement": {
      "types": "./dist/announcement.d.ts",
      "default": "./dist/announcement.js"
    },
    "./polls": {
      "types": "./dist/polls.d.ts",
      "default": "./dist/polls.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "default": "./dist/upload.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@smartresidence/config-tsconfig": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
